# --- Obligatorias ---------------------------------------------------------
# Postgres (Neon). Formato: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# Clave que usa la extensión para hablar con el servidor (genera una larga y aleatoria)
MINUTA_API_KEY=
# Contraseña del panel web (si se deja vacía se usa MINUTA_API_KEY)
DASHBOARD_PASSWORD=

# --- Proveedores ----------------------------------------------------------
# Transcripción: basta con UNA de las dos.
#  - GROQ_API_KEY (gratis, sin tarjeta, console.groq.com): Whisper large v3 turbo.
#    Plan gratuito ≈ 8 h de audio al día y 2 h por hora. Distingue «Tú» / «Otros participantes».
#  - DEEPGRAM_API_KEY (de pago): además separa a cada participante.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Análisis con IA: si hay ANTHROPIC_API_KEY se usa Claude (de pago, mejor calidad).
# Si no, se usa gratis un modelo abierto en Groq (misma GROQ_API_KEY).
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# --- Correo ---------------------------------------------------------------
# Destinatario por defecto (se puede cambiar en el panel)
EMAIL_TO=
# Remitente. Sin dominio verificado en Resend usa onboarding@resend.dev
# (solo puede enviar al correo de tu cuenta de Resend).
EMAIL_FROM=Minuta <onboarding@resend.dev>

# --- Opcionales -----------------------------------------------------------
# URL pública de la app (se deduce en Vercel si no se define)
APP_URL=
# Modelo de Claude para el análisis
ANTHROPIC_MODEL=claude-opus-5-5
# Proveedor de transcripción si hay dos claves (groq | deepgram). Por defecto, Groq.
TRANSCRIPTION_PROVIDER=
GROQ_MODEL=whisper-large-v3-turbo
# Proveedor de análisis si hay dos claves (claude | groq). Por defecto, Claude si hay clave.
ANALYSIS_PROVIDER=
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
# Modelo de Deepgram
DEEPGRAM_MODEL=nova-3
