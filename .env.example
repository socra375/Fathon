# --- Obligatorias ---------------------------------------------------------
# Postgres (Neon). Formato: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# Clave que usa la extensión para hablar con el servidor (genera una larga y aleatoria)
MINUTA_API_KEY=
# Contraseña del panel web (si se deja vacía se usa MINUTA_API_KEY)
DASHBOARD_PASSWORD=

# --- Rotación automática de proveedores -----------------------------------
# Cada paso prueba sus proveedores en orden. Si uno alcanza su límite gratuito se anota
# cuándo vuelve y se pasa al siguiente; si todos están en pausa, la reunión espera sola.
# Basta con UNA clave por paso; cuantas más pongas, menos esperas.

# 1) Transcripción (voz → texto). Orden: groq, deepgram.
#    Gemini y OpenRouter NO transcriben el formato de audio del navegador (WebM): no sirven aquí.
#  - GROQ_API_KEY (gratis, console.groq.com): Whisper large v3 turbo, ≈ 2 h de audio por hora.
#  - DEEPGRAM_API_KEY (crédito inicial gratis): respaldo cuando Groq se agota; separa participantes.
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# 2) Análisis con IA. Orden: claude, gemini, openrouter, groq.
#  - GEMINI_API_KEY (gratis, aistudio.google.com): ventana de 1 M de tokens, analiza la reunión de una vez.
#  - OPENROUTER_API_KEY (gratis, openrouter.ai): modelos «:free» (≈ 50 peticiones al día; 1.000 con 10 USD de saldo).
#  - Groq (misma GROQ_API_KEY): gratis pero con ~8.000 tokens por minuto; analiza por tramos.
#  - ANTHROPIC_API_KEY (de pago): la mejor calidad, si la pones va primero.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# 3) Correo. Orden: resend, smtp. Se envía a cada destinatario por separado.
#  - RESEND_API_KEY: sin dominio verificado solo envía a la dirección de tu cuenta de Resend.
#  - SMTP (p. ej. Gmail): permite enviar a cualquiera sin dominio. En Gmail activa la verificación en
#    2 pasos y crea una «contraseña de aplicación» (myaccount.google.com/apppasswords).
RESEND_API_KEY=
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=Minuta <tu-correo@gmail.com>

# --- Correo ---------------------------------------------------------------
# Destinatarios por defecto, separados por comas (se pueden cambiar en el panel; máximo 10)
EMAIL_TO=
# Remitente para Resend. Sin dominio verificado usa onboarding@resend.dev
EMAIL_FROM=Minuta <onboarding@resend.dev>

# --- Opcionales -----------------------------------------------------------
# URL pública de la app (se deduce en Vercel si no se define)
APP_URL=
# Cambiar el orden o excluir proveedores (lista separada por comas)
TRANSCRIPTION_PROVIDERS=groq,deepgram
ANALYSIS_PROVIDERS=claude,gemini,openrouter,groq
EMAIL_PROVIDERS=resend,smtp
# Modelos
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=whisper-large-v3-turbo
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
DEEPGRAM_MODEL=nova-3
# Tokens de entrada que admite una petición de cada proveedor (para decidir si se analiza de una vez o por tramos)
# GEMINI_MAX_INPUT_TOKENS=800000
# OPENROUTER_MAX_INPUT_TOKENS=24000
# GROQ_MAX_INPUT_TOKENS=5800
